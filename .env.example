# Copy to .env. The admin console runs on http://localhost:3001 (npm run dev).
VITE_ADMIN_API_URL=http://localhost:8010
VITE_SHOP_URL=http://localhost:3000

# Map tiles for the live delivery / courier boards — any MapLibre style.json (keyless OpenFreeMap by default).
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
VITE_MAPTILER_KEY=
